APP_MODE=LOCAL_DEV

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# Embeddings / Vector DB
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=.chroma
COLLECTION_PREFIX=pdf_rag

# Local free generation (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
# Use a 1B model on low-RAM machines; 3b needs ~2.3+ GiB free for Ollama.
OLLAMA_MODEL=llama3.2:1b
LLM_TIMEOUT_SECONDS=60
